# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
# Defaults connect directly to the live AWS Events API server (https://api.awsevents.com/v1).

# --------------------------------------------------------------------------- #
# AWS Events API (re:Invent 2026 live endpoints)
# --------------------------------------------------------------------------- #
# Base URL of the live REST surface
REPLAN_API_BASE_URL=https://api.awsevents.com
REPLAN_API_VERSION=v1

# Target event ID (e.g. reinvent2026 or Summit-Dubai-2026)
REPLAN_EVENT_ID=reinvent2026

# Authentication:
# Run `replan login` to sign in via AWS Builder ID OAuth PKCE,
# or provide a Bearer access token here:
REPLAN_BEARER_TOKEN=

# Remote MCP server exposed by AWS for the same catalog:
REPLAN_MCP_URL=https://api.awsevents.com/mcp

# Which surface the CLI talks to by default: rest | mcp
REPLAN_SURFACE=rest

# --------------------------------------------------------------------------- #
# Politeness / safety limits for the seat watcher
# --------------------------------------------------------------------------- #
# Hard ceiling on outbound requests per minute, enforced client-side.
REPLAN_MAX_REQUESTS_PER_MINUTE=30
# Seconds between polls of a single watched session.
REPLAN_WATCH_INTERVAL_SECONDS=90

# --------------------------------------------------------------------------- #
# Notifications (all optional)
# --------------------------------------------------------------------------- #
REPLAN_SLACK_WEBHOOK_URL=
REPLAN_SNS_TOPIC_ARN=
AWS_REGION=us-west-2

# --------------------------------------------------------------------------- #
# Local state
# --------------------------------------------------------------------------- #
# Overrides the platform default (~/.local/share/replan on Linux).
REPLAN_STATE_DIR=
