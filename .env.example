# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
# Everything here is optional. With no credentials at all, replan runs fully
# against the bundled synthetic catalog (`--source fixture`), which is how the
# demo and the test suite work.

# --------------------------------------------------------------------------- #
# re:Invent Event Catalog API
# --------------------------------------------------------------------------- #
# Base URL of the REST surface (OpenAPI 3.1). Set this once AWS publishes it.
REPLAN_API_BASE_URL=

# Authentication. replan supports several schemes because the published
# contract was not available at build time; pick the one the API actually uses:
#   bearer  -> Authorization: Bearer <token>
#   apikey  -> x-api-key: <token>
#   header  -> <REPLAN_AUTH_HEADER>: <token>
#   none    -> no auth (fixtures / local)
REPLAN_AUTH_SCHEME=bearer
REPLAN_AUTH_TOKEN=
REPLAN_AUTH_HEADER=

# Remote MCP server exposed by AWS for the same catalog.
REPLAN_REMOTE_MCP_URL=

# Which surface the CLI talks to by default: fixture | rest | remote-mcp
REPLAN_SOURCE=fixture

# --------------------------------------------------------------------------- #
# Politeness / safety limits for the seat watcher
# --------------------------------------------------------------------------- #
# Hard ceiling on outbound requests per minute, enforced client-side.
REPLAN_MAX_REQUESTS_PER_MINUTE=30
# Seconds between polls of a single watched session.
REPLAN_WATCH_INTERVAL_SECONDS=90

# --------------------------------------------------------------------------- #
# Notifications (all optional)
# --------------------------------------------------------------------------- #
REPLAN_SLACK_WEBHOOK_URL=
REPLAN_SNS_TOPIC_ARN=
AWS_REGION=us-west-2

# --------------------------------------------------------------------------- #
# Local state
# --------------------------------------------------------------------------- #
# Overrides the platform default (~/.local/share/replan on Linux).
REPLAN_STATE_DIR=
